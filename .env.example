# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/cashbook_db?schema=public"

# UPI Feature Flags
# Set to 'true' to enable live banking UPI gateways; 'false' uses Mock Payment Adapter
NEXT_PUBLIC_ENABLE_LIVE_UPI=false

# App Configuration
NEXT_PUBLIC_APP_NAME="CashBook UPI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
